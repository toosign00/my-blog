{
  "name": "my-blog",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-covers.mjs && next dev",
    "build": "node scripts/sync-covers.mjs && next build",
    "start": "next start",
    "test:unit": "jest",
    "test:node": "node --experimental-strip-types --test scripts/*.test.mjs tests/integration/*.test.mjs",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "check": "biome check . && tsc --noEmit && node scripts/check-tokens.mjs",
    "fix": "biome check --write ."
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css}": "biome check --write --no-errors-on-unmatched",
    "*.{ts,tsx,mdx,css}": "node scripts/check-tokens.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.3.1",
    "@tanstack/react-query": "^5.108.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "dayjs": "^1.11.23",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.75.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-activity-calendar": "^3.2.1",
    "react-dom": "^19.3.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query-devtools": "^5.108.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/jest": "^30.0.0",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.1",
    "npm-check-updates": "^23.1.1",
    "postcss": "^8.5.33",
    "remark-gfm": "^4.0.1",
    "schema-dts": "^2.1.0",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.21.0"
}
