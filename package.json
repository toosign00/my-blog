    "fuse.js": "^7.5.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-activity-calendar": "^3.2.1",
    "react-dom": "^19.3.0",
    "sharp": "0.35.4",
