{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!pnpm-lock.yaml", "!.next", "!node_modules"],
    "ignoreUnknown": true
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "root": ".",
    "defaultBranch": "main"
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedKeys": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "attributePosition": "auto"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 100
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineWidth": 100
    },
    "linter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noParameterAssign": "error",
        "useDefaultParameterLast": "error",
        "useSingleVarDeclarator": "off",
        "useConst": "error",
        "noUselessElse": "error",
        "useSelfClosingElements": "error",
        "useTemplate": "error",
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "strictCase": false,
            "requireAscii": true
          }
        },
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "tailwind-merge": "Import twMerge from '@/utils/tw-merge-util' so the design system's type scale is recognized."
            }
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUndeclaredDependencies": "error",
        "noUnknownTypeSelector": "error",
        "useUniqueElementIds": "off"
      },
      "suspicious": {
        "noVar": "error",
        "noExplicitAny": "warn",
        "noEmptyBlockStatements": "error",
        "noArrayIndexKey": "warn",
        "noUnknownAtRules": "error"
      },
      "complexity": {
        "useLiteralKeys": "error",
        "noImportantStyles": "error"
      },
      "performance": {
        "noDelete": "off",
        "noImgElement": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "a11y": {
        "useKeyWithClickEvents": "error",
        "useAltText": "error",
        "noAutofocus": "warn",
        "useValidAnchor": "error",
        "useButtonType": "error",
        "noSvgWithoutTitle": "off",
        "noStaticElementInteractions": "off",
        "useAriaPropsSupportedByRole": "off",
        "useSemanticElements": "off"
      },
      "nursery": {
        "noFloatingPromises": "warn"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/utils/tw-merge-util.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": ["*.config.js", "*.config.ts", "next.config.*"],
      "linter": {
        "rules": {
          "suspicious": {}
        }
      }
    },
    {
      "includes": ["**/*.test.*", "**/*.spec.*", "src/test/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "noParameterAssign": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.d.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/**/*.tsx", "src/app/**/_components/**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["PascalCase"],
                "strictCase": false
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/hooks/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["camelCase"],
                "strictCase": false,
                "match": "(use[A-Z].*?)[.](.+)"
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/index.*",
        "src/components/features/mdx/code.*",
        "src/components/features/mdx/data-display.*",
        "src/components/features/mdx/flow.*",
        "src/components/features/mdx/interactive.*",
        "src/components/features/mdx/mdx-components.*",
        "src/components/features/mdx/typography.*"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["kebab-case"],
                "strictCase": false
              }
            }
          }
        }
      }
    }
  ]
}
